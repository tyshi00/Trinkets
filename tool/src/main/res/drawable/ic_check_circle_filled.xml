<?xml version="1.0" encoding="utf-8"?>
<!--
  Circle with a checkmark punched out of it, for the Reflection "used" state.
  The SDK ships CIRCLE and Aventura ships a bare tick, but a bar button takes a
  single Painter rather than a composable, so the two are combined here.

  Uses evenOdd fill so the tick reads as background color through the disc,
  which keeps it correct in both light and dark themes without a second asset.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M12,1 A11,11 0 1,0 12,23 A11,11 0 1,0 12,1 Z M17.09,8.41 L10.5,16.09 L6.91,12.5 L8.32,11.09 L10.41,13.18 L15.59,7.16 Z" />
</vector>
