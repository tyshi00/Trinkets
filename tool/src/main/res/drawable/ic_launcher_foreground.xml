<?xml version="1.0" encoding="utf-8"?>
<!--
    Original "message in a bottle" mark: a corked glass bottle holding a
    ribbon-tied scroll with a small star charm, standing in for small
    keepsakes ("Trinkets") tucked away for later. Rounded shoulders (rather
    than sharp corners) so it reads clearly as glass. Not modeled on any
    specific existing artwork. Built entirely from filled shapes on single
    lines each (the bottle outline is a filled silhouette with an evenOdd
    "hole" cut out of the middle) to avoid any parser ambiguity. Every
    point is checked to stay within the adaptive icon's 66dp safe zone
    (max ~32.2dp from center) so it isn't clipped by circular/squircle/
    rounded-square launcher masks, e.g. when shown by an installer such as
    Obtainium.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Bottle outline: cork + neck + rounded-shoulder body, hollowed out with an evenOdd inner cutout so it reads as glass rather than a solid block. -->
    <path android:fillColor="#FFFFFFFF" android:fillType="evenOdd" android:pathData="M47,24 L61,24 L61,34 A10,10 0 0 1 73,44 L73,70 A10,10 0 0 1 63,80 L45,80 A10,10 0 0 1 35,70 L35,44 A10,10 0 0 1 47,34 Z M50,27 L58,27 L58,34 A8,8 0 0 1 69,45 L69,67 A8,8 0 0 1 61,75 L47,75 A8,8 0 0 1 39,67 L39,45 A8,8 0 0 1 50,34 Z" />

    <!-- Ribbon-tied scroll inside, tucked in at an angle -->
    <group android:pivotX="53" android:pivotY="56" android:rotation="25">
        <path android:fillColor="#FFFFFFFF" android:pathData="M48.5,45 A4.5,4.5 0 0 1 57.5,45 L57.5,67 A4.5,4.5 0 0 1 48.5,67 Z" />
        <path android:fillColor="#FFFFFFFF" android:pathData="M47.5,58 L58.5,58 L58.5,61 L47.5,61 Z" />
    </group>

    <!-- Thin charm string from the scroll's ribbon down to the star -->
    <path android:fillColor="#FFFFFFFF" android:pathData="M58,62 L61,68 L59.5,68.6 L56.5,62.6 Z" />

    <!-- Small star charm, no scattered sparkles -->
    <path android:fillColor="#FFFFFFFF" android:pathData="M61,68.5 L61.85,71.15 L64.5,72 L61.85,72.85 L61,75.5 L60.15,72.85 L57.5,72 L60.15,71.15 Z" />

</vector>
